From: Mikael Magnusson <mikachu@gmail.com>
Date: Sat, 5 Sep 2026 18:12:40 +0200
Subject: [PATCH] Disable management notif

---
 components/policy/core/common/management/management_service.cc | 1 +
 1 file changed, 1 insertion(+)

diff --git a/components/policy/core/common/management/management_service.cc b/components/policy/core/common/management/management_service.cc
index 3d0a1f6ec7..912eae4d22 100644
--- a/components/policy/core/common/management/management_service.cc
+++ b/components/policy/core/common/management/management_service.cc
@@ -245,6 +245,7 @@ int ManagementService::GetManagementAuthorities() {
     return management_authorities_for_testing_.value();
 
   int result = 0;
+  if (!result) { return EnterpriseManagementAuthority::NONE; }
   for (const auto& provider : management_status_providers_)
     result |= provider->GetAuthority();
   return result;
