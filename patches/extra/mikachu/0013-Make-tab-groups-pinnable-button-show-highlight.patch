From a85ab6506aa3f107cfb8656e6d51d7b754de9251 Mon Sep 17 00:00:00 2001
From: Mikael Magnusson <mikachu@gmail.com>
Date: Sat, 25 Jul 2026 06:02:51 +0200
Subject: [PATCH] Make tab groups pinnable button show highlight

---
 chrome/browser/ui/browser_actions.cc             | 16 ++++++++++++++++
 .../saved_tab_group_everything_menu.cc           |  7 +++++++
 .../saved_tab_group_everything_menu.h            |  5 +++++
 3 files changed, 28 insertions(+)

diff --git a/chrome/browser/ui/browser_actions.cc b/chrome/browser/ui/browser_actions.cc
index b2592bf9b8..cbe98279b1 100644
--- a/chrome/browser/ui/browser_actions.cc
+++ b/chrome/browser/ui/browser_actions.cc
@@ -1219,6 +1219,7 @@ void BrowserActions::InitializeChromeMenuActions() {
                   return;
                 }
                 gfx::Rect anchor_bounds;
+                PinnedActionToolbarButton* button = nullptr;
                 auto* toolbar_button_provider =
                     bwi->GetBrowserForMigrationOnly()
                         ->GetBrowserView()
@@ -1232,15 +1233,30 @@ void BrowserActions::InitializeChromeMenuActions() {
                             .GetIfView();
                     if (anchor_view) {
                       anchor_bounds = anchor_view->GetBoundsInScreen();
+                      button = views::AsViewClass<PinnedActionToolbarButton>(anchor_view);
                     }
                   }
                 }
+              if (button) {
+                button->AddHighlight();
+              }
                 self->tab_groups_menu_ =
                     std::make_unique<tab_groups::STGEverythingMenu>(
                         /*menu_button_controller=*/nullptr,
                         bwi->GetBrowserForMigrationOnly(),
                         tab_groups::STGEverythingMenu::MenuContext::
                             kSavedTabGroupBar);
+              if (button) {
+                self->tab_groups_menu_->SetOnMenuClosedCallback(
+                    base::BindOnce(
+                        [](base::WeakPtr<views::View> weak_view) {
+                          if (auto* view = weak_view.get()) {
+                            views::AsViewClass<PinnedActionToolbarButton>(view)
+                                ->ResetHighlight();
+                          }
+                        },
+                        button->GetWeakPtr()));
+              }
                 self->tab_groups_menu_->RunMenu(anchor_bounds);
               },
               base::Unretained(this), bwi))
diff --git a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
index c377e0a149..3423c25f1e 100644
--- a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
+++ b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
@@ -430,8 +430,15 @@ void STGEverythingMenu::WillShowMenu(views::MenuItemView* menu) {
   }
 }
 
+void STGEverythingMenu::SetOnMenuClosedCallback(base::OnceClosure callback) {
+  on_menu_closed_callback_ = std::move(callback);
+}
+
 void STGEverythingMenu::OnMenuClosed(views::MenuItemView* menu) {
   expand_on_hover_lock_.reset();
+  if (on_menu_closed_callback_) {
+    std::move(on_menu_closed_callback_).Run();
+  }
 }
 
 STGEverythingMenu::~STGEverythingMenu() = default;
diff --git a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
index 52dc89a9f1..d3d585ce30 100644
--- a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
+++ b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
@@ -10,6 +10,7 @@
 #include <optional>
 #include <vector>
 
+#include "base/functional/callback.h"
 #include "base/memory/raw_ptr.h"
 #include "base/uuid.h"
 #include "chrome/browser/ui/toolbar/app_menu_model.h"
@@ -66,6 +67,8 @@ class STGEverythingMenu : public views::MenuDelegate,
   // Runs the menu. Only called via pressing the Everything button.
   void RunMenu(gfx::Rect anchor_bounds_override = gfx::Rect());
 
+  void SetOnMenuClosedCallback(base::OnceClosure callback);
+
   bool IsShowing() { return menu_runner_ && menu_runner_->IsRunning(); }
 
   // Whether or not a saved tab group item in the Everything menu should have
@@ -125,6 +128,8 @@ class STGEverythingMenu : public views::MenuDelegate,
   // Owned by the Everything button.
   raw_ptr<views::MenuButtonController> const menu_button_controller_;
 
+  base::OnceClosure on_menu_closed_callback_;
+
   // The command id that gets updated and assigned to tab groups and their
   // submenu items.
   int latest_tab_group_command_id_ = -1;
-- 
2.38.1

