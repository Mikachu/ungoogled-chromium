From bd172474debf0b36974dba569d742968c189a903 Mon Sep 17 00:00:00 2001
From: Mikael Magnusson <mikachu@gmail.com>
Date: Sat, 25 Jul 2026 06:02:51 +0200
Subject: [PATCH] Add tab groups pinnable button to toolbar

---
 chrome/browser/ui/browser_actions.cc          | 39 +++++++++++++++++--
 chrome/browser/ui/browser_actions.h           |  5 +++
 .../saved_tab_group_everything_menu.cc        |  7 +++-
 .../saved_tab_group_everything_menu.h         |  3 +-
 .../customize_toolbar/customize_toolbar.mojom |  1 +
 .../customize_toolbar_handler.cc              |  6 +++
 6 files changed, 54 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/ui/browser_actions.cc b/chrome/browser/ui/browser_actions.cc
index 70e06201ca..72a166fd6b 100644
--- a/chrome/browser/ui/browser_actions.cc
+++ b/chrome/browser/ui/browser_actions.cc
@@ -98,6 +98,7 @@
 #include "chrome/browser/ui/ui_features.h"
 #include "chrome/browser/ui/user_education/browser_user_education_interface.h"
 #include "chrome/browser/ui/views/bookmarks/bookmark_page_action_controller.h"
+#include "chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h"
 #include "chrome/browser/ui/views/commerce/discounts_page_action_view_controller.h"
 #include "chrome/browser/ui/views/file_system_access/file_system_access_bubble_controller.h"
 #include "chrome/browser/ui/views/frame/browser_view.h"
@@ -952,12 +953,39 @@ void BrowserActions::InitializeChromeMenuActions() {
   root_action_item_->AddChild(
       actions::ActionItem::Builder(
           base::BindRepeating(
-              [](BrowserWindowInterface* bwi, actions::ActionItem* item,
+              [](BrowserActions* self, BrowserWindowInterface* bwi,
+                 actions::ActionItem* item,
                  actions::ActionInvocationContext context) {
-                // This functionality is controlled by the MenuButtonController.
-                // It should have a callback for ShowEverythingMenu.
+                if (self->tab_groups_menu_ &&
+                    self->tab_groups_menu_->IsShowing()) {
+                  return;
+                }
+                gfx::Rect anchor_bounds;
+                auto* toolbar_button_provider =
+                    bwi->GetBrowserForMigrationOnly()
+                        ->GetBrowserView()
+                        .toolbar_button_provider();
+                if (toolbar_button_provider) {
+                  auto* pinned_actions =
+                      toolbar_button_provider->GetPinnedToolbarActions();
+                  if (pinned_actions) {
+                    views::View* anchor_view =
+                        pinned_actions->GetBubbleAnchor(kActionTabGroupsMenu)
+                            .GetIfView();
+                    if (anchor_view) {
+                      anchor_bounds = anchor_view->GetBoundsInScreen();
+                    }
+                  }
+                }
+                self->tab_groups_menu_ =
+                    std::make_unique<tab_groups::STGEverythingMenu>(
+                        /*menu_button_controller=*/nullptr,
+                        bwi->GetBrowserForMigrationOnly(),
+                        tab_groups::STGEverythingMenu::MenuContext::
+                            kSavedTabGroupBar);
+                self->tab_groups_menu_->RunMenu(anchor_bounds);
               },
-              bwi))
+              base::Unretained(this), bwi))
           .SetActionId(kActionTabGroupsMenu)
           .SetText(BrowserActions::GetCleanTitleAndTooltipText(
               l10n_util::GetStringUTF16(IDS_SAVED_TAB_GROUPS_MENU)))
@@ -968,6 +996,9 @@ void BrowserActions::InitializeChromeMenuActions() {
                   ? kGridViewIcon
                   : kSavedTabGroupBarEverythingOldIcon,
               ui::kColorIcon))
+          .SetProperty(actions::kActionItemPinnableKey,
+                       std::underlying_type_t<actions::ActionPinnableState>(
+                           actions::ActionPinnableState::kPinnable))
           .Build());
 
   root_action_item_->AddChild(
diff --git a/chrome/browser/ui/browser_actions.h b/chrome/browser/ui/browser_actions.h
index 4fc2dc9602..8107d22c09 100644
--- a/chrome/browser/ui/browser_actions.h
+++ b/chrome/browser/ui/browser_actions.h
@@ -19,6 +19,10 @@ namespace actions {
 class ActionItem;
 }  // namespace actions
 
+namespace tab_groups {
+class STGEverythingMenu;
+}
+
 // Actions that a user can take that are scoped to a browser window.
 class BrowserActions {
  public:
@@ -49,6 +53,7 @@ class BrowserActions {
   std::unique_ptr<BrowserActionPrefsListener> browser_action_prefs_listener_;
   const raw_ref<BrowserWindowInterface> bwi_;
   const raw_ref<Profile> profile_;
+  std::unique_ptr<tab_groups::STGEverythingMenu> tab_groups_menu_;
 };
 
 #endif  // CHROME_BROWSER_UI_BROWSER_ACTIONS_H_
diff --git a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
index 8956ac4766..88d411dae3 100644
--- a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
+++ b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.cc
@@ -290,7 +290,7 @@ void STGEverythingMenu::PopulateMenu(views::MenuItemView* parent) {
   }
 }
 
-void STGEverythingMenu::RunMenu() {
+void STGEverythingMenu::RunMenu(gfx::Rect anchor_bounds_override) {
   auto root = std::make_unique<views::MenuItemView>(this);
   PopulateMenu(root.get());
 
@@ -302,9 +302,12 @@ void STGEverythingMenu::RunMenu() {
 
   menu_runner_ = std::make_unique<views::MenuRunner>(
       std::move(root), views::MenuRunner::HAS_MNEMONICS);
+  gfx::Rect anchor_bounds = menu_button_controller_
+      ? menu_button_controller_->button()->GetAnchorBoundsInScreen()
+      : anchor_bounds_override;
   menu_runner_->RunMenuAt(
       widget_, menu_button_controller_,
-      menu_button_controller_->button()->GetAnchorBoundsInScreen(),
+      anchor_bounds,
       views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kNone);
 }
 
diff --git a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
index cf06a54568..fedb557aa2 100644
--- a/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
+++ b/chrome/browser/ui/views/bookmarks/saved_tab_groups/saved_tab_group_everything_menu.h
@@ -17,6 +17,7 @@
 #include "components/saved_tab_groups/public/features.h"
 #include "ui/base/mojom/menu_source_type.mojom-forward.h"
 #include "ui/menus/simple_menu_model.h"
+#include "ui/gfx/geometry/rect.h"
 #include "ui/views/controls/button/menu_button_controller.h"
 #include "ui/views/controls/menu/menu_delegate.h"
 #include "ui/views/controls/menu/menu_item_view.h"
@@ -63,7 +64,7 @@ class STGEverythingMenu : public views::MenuDelegate,
   bool ShouldEnableCommand(int command_id);
 
   // Runs the menu. Only called via pressing the Everything button.
-  void RunMenu();
+  void RunMenu(gfx::Rect anchor_bounds_override = gfx::Rect());
 
   bool IsShowing() { return menu_runner_ && menu_runner_->IsRunning(); }
 
diff --git a/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar.mojom b/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar.mojom
index 8f38847e30..29cb3468fe 100644
--- a/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar.mojom
+++ b/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar.mojom
@@ -32,6 +32,7 @@ enum ActionId {
   kShowChromeLabs,
   kCopyLink,
   kTabSearch,
+  kTabGroupsMenu,
   kSplitTab,
   kContextualTasks,
   kShowTabsFromOtherDevices,
diff --git a/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar_handler.cc b/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar_handler.cc
index af0ef124be..e036573e12 100644
--- a/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar_handler.cc
+++ b/chrome/browser/ui/webui/side_panel/customize_chrome/customize_toolbar/customize_toolbar_handler.cc
@@ -99,6 +99,8 @@
     case kActionSidePanelShowTabsFromOtherDevices:
       return side_panel::customize_chrome::mojom::ActionId::
           kShowTabsFromOtherDevices;
+    case kActionTabGroupsMenu:
+      return side_panel::customize_chrome::mojom::ActionId::kTabGroupsMenu;
     default:
       return std::nullopt;
   }
@@ -162,6 +164,8 @@
       return kActionSplitTab;
     case side_panel::customize_chrome::mojom::ActionId::kContextualTasks:
       return kActionSidePanelShowContextualTasks;
+    case side_panel::customize_chrome::mojom::ActionId::kTabGroupsMenu:
+      return kActionTabGroupsMenu;
     default:
       return std::nullopt;
   }
@@ -370,6 +374,8 @@
              side_panel::customize_chrome::mojom::CategoryId::kTools);
   add_action(kActionShowChromeLabs,
              side_panel::customize_chrome::mojom::CategoryId::kTools);
+  add_action(kActionTabGroupsMenu,
+             side_panel::customize_chrome::mojom::CategoryId::kTools);
 
   std::move(callback).Run(std::move(actions));
 }

