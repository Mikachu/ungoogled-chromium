Subject: [PATCH] Remove position setting code

Only remove the SetWmNormalHints call to minimize conflicts.
---
 ui/ozone/platform/x11/x11_window.cc | 1 -
 1 file changed, 1 deletion(-)

diff --git a/ui/ozone/platform/x11/x11_window.cc b/ui/ozone/platform/x11/x11_window.cc
index 7f3275d011..ace9cf3486 100644
--- a/ui/ozone/platform/x11/x11_window.cc
+++ b/ui/ozone/platform/x11/x11_window.cc
@@ -1993,7 +1993,6 @@ void X11Window::Map(bool inactive) {
   // frame width when running with window manager.
   size_hints.flags |= x11::SIZE_HINT_P_WIN_GRAVITY;
   size_hints.win_gravity = x11::WIN_GRAVITY_HINT_STATIC_GRAVITY;
-  connection_->SetWmNormalHints(xwindow_, size_hints);
 
   ignore_keyboard_input_ = inactive;
   auto wm_user_time_ms = ignore_keyboard_input_
